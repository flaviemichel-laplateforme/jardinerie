APP_ENV=development
# Variables Applicatives (PHP)
JWT_SECRET=Key_Jardinerie_Secret_Key_2026_Super_Secure!*

# Connexion PDO pour PHP
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
# DB_PASSWORD : uniquement nécessaire hors Docker (ex: hébergement Plesk).
# En local avec Docker, le mot de passe vient du secret (secrets/db_password.txt).
DB_PASSWORD=


# API STRIPE (Clé Secrète et Webhook)
STRIPE_SECRET_KEY=sk_test_51(récupéré sur le dashboard stripe)
STRIPE_WEBHOOK_SECRET=whsec_... (générée plus tard lors des tests webhook)

RESEND_API_KEY=
RESEND_FROM_EMAIL=@resend.dev
RESEND_TO_TEST=votre-email@gmail.com  ← votre vraie adresse pour recevoir les tests