APP_ENV=development
# Sites autorisés à appeler l'API avec le cookie de session, séparés par des virgules (sans / final).
# Sans cette variable : localhost:5173, localhost:3000, jardinerie.vercel.app et jardinerie-next.vercel.app.
# ALLOWED_ORIGINS=https://jardinerie.vercel.app,https://jardinerie-next.vercel.app
# SameSite du cookie de session : None (défaut en production, l'ancien front-end est sur un autre domaine) ou Lax
# (à activer quand le navigateur ne parle plus qu'au site, via le relais Next.js : bloque les requêtes POST venues d'autres sites).
# COOKIE_SAMESITE=Lax
# Variables Applicatives (PHP)
# Clé qui signe les jetons de connexion : 32 caractères minimum, secrète, différente en local et en production.
# Quiconque la connaît peut se faire passer pour n'importe quel utilisateur, administrateur compris.
# Génération : php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=

# Connexion PDO pour PHP
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
# DB_PASSWORD : uniquement nécessaire hors Docker (ex: hébergement Plesk).
# En local avec Docker, le mot de passe vient du secret (secrets/db_password.txt).
DB_PASSWORD=


# API STRIPE (Clé Secrète et Webhook)
STRIPE_SECRET_KEY=sk_test_51(récupéré sur le dashboard stripe)
STRIPE_WEBHOOK_SECRET=whsec_... (générée plus tard lors des tests webhook)

# E-mails transactionnels (Brevo) : Paramètres > SMTP et API > Clés API (droits restreints : « Emails transactionnels : Tous »)
BREVO_API_KEY=
# ATTENTION : une valeur contenant un espace doit être entre guillemets, sinon le .env entier devient illisible
# Expéditeur : doit être un expéditeur VÉRIFIÉ dans Brevo (Paramètres > Expéditeurs, domaine, IP)
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="La Jardinerie"
# Facultatif : adresse de réponse (par défaut, l'expéditeur)
# MAIL_REPLY_TO=
# Étiquette du site dans les statistiques Brevo (utile quand un même compte sert plusieurs sites)
MAIL_TAG=jardinerie