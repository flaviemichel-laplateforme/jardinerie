# Adresse de l'API PHP, utilisée par le serveur Next.js (rendu des pages + relais de "/api")
# Local (Docker) : http://localhost:8000   |   Production : l'adresse publique de l'API sur Plesk
API_INTERNAL_URL=http://localhost:8000

# Adresse d'où le navigateur charge les images des produits (servies par l'API PHP)
NEXT_PUBLIC_ASSET_BASE_URL=http://localhost:8000

# Adresse publique du site (liens canoniques, partage sur les réseaux, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé publique Stripe (utilisée à l'étape 3, tunnel de paiement)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_51... (à récupérer sur votre dashboard Stripe)

# Indexation par Google : laisser à false tant que ce site n'a pas remplacé l'ancien (sinon contenu dupliqué).
# Passer à true uniquement au moment de la bascule de domaine.
SITE_INDEXABLE=false
